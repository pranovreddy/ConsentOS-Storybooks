{
  "name": "digiconsent-design-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "build": "node scripts/gen-index.mjs && vite build --config vite.lib.config.ts && node scripts/build-tokens.mjs",
    "build-share": "node scripts/precompile-share.mjs && vite build --config vite.share.config.ts && node scripts/finish-share.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/vue": "^1.66.0",
    "reka-ui": "^2.11.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/vue3-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vue": "^3.5.13",
    "vue-tsc": "^3.3.14"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "share/DigiConsent-Design-System.html",
    "src/theme.css",
    "src/styles",
    "src/assets"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./theme.css": "./src/theme.css"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pranovreddy/ConsentOS-Storybooks.git"
  }
}
